# Python
__pycache__/
*.py[cod]
*.egg-info/

# 运行产物（本地记忆库数据，若不想入库可取消注释）
# vcp_memory.json
/.venv/

# 爬取原始数据（图片等大文件不入库）
/data/

# 备份目录与难图归档（不入库）
/docs_backup*/
/hard_images_*/
/check_*/

# 编辑备份(不入库)
*.bak*

# 流程监控诊断（stage_runner watchdog 的 *.deadlock.json 与旧日志不入库）
/logs/


# 本地缓存/模型缓存（不入库）
/.cache/
/.model_cache/

# 人工标注/评测工作集（debug/handwriting_eval 约 113M 不入库）
/debug/
